ITS_APP_TITLE=Hệ thống nhận diện biển số xe máy
ITS_BASE_DIR=C:\Users\YourUser\plate_demo_data
ITS_DB_NAME=parking_system.db
ITS_UPLOAD_DIR=uploads
ITS_LOG_DIR=logs
ITS_REPORT_DIR=reports
ITS_DEFAULT_MODEL_LABEL=Baseline detector

# Accuracy-first OCR / CV
ITS_FAST_MODE=false
ITS_OCR_ACCURACY_MODE=true
ITS_ENABLE_DEEP_OCR_RETRY=true
ITS_DEEP_OCR_CONFIDENCE_THRESHOLD=0.95
ITS_ENABLE_PADDLE_OCR=false
ITS_ENABLE_PADDLE_FALLBACK=true
ITS_ENABLE_OPENAI_VISION=true
ITS_ENABLE_VISION_IN_AUTO=true
ITS_OPENAI_API_KEY=replace-with-9router-or-provider-key
ITS_OPENAI_BASE_URL=http://localhost:20128/v1
ITS_OPENAI_VISION_MODEL=cx/gpt-6-sol
ITS_OPENAI_API_MODE=responses
ITS_OPENAI_TIMEOUT_SECONDS=45
ITS_BENCHMARK_UPLOADS_DIR=C:\Users\YourUser\plate_demo_data\uploads

# API security
ITS_API_TOKEN=replace-with-random-api-token
ITS_API_JWT_SECRET=replace-with-long-random-secret
ITS_API_JWT_EXPIRE_MINUTES=120
ITS_API_ALLOW_STATIC_TOKENS=false
ITS_API_EXPOSE_INTERNAL_PATHS=false
ITS_API_BEARER_ADMIN_TOKEN=
ITS_API_BEARER_OPERATOR_TOKEN=
ITS_API_BEARER_VIEWER_TOKEN=
ITS_LOG_LEVEL=INFO

# Streamlit accounts
ITS_STREAMLIT_AUTH_ENABLED=true
ITS_STREAMLIT_ADMIN_USERNAME=admin
ITS_STREAMLIT_ADMIN_PASSWORD=replace-with-strong-admin-password
ITS_STREAMLIT_OPERATOR_USERNAME=operator
ITS_STREAMLIT_OPERATOR_PASSWORD=replace-with-strong-operator-password
ITS_STREAMLIT_VIEWER_USERNAME=viewer
ITS_STREAMLIT_VIEWER_PASSWORD=replace-with-strong-viewer-password

# Real hardware endpoints. Leave empty for simulator mode.
# Examples:
# ITS_CAMERA_URL=rtsp://user:password@192.168.1.10:554/stream1
# ITS_MQTT_URL=mqtt://user:password@192.168.1.20:1883/its
# ITS_BARRIER_URL=http://192.168.1.30/api/barrier
ITS_CAMERA_URL=
ITS_MQTT_URL=
ITS_BARRIER_URL=
